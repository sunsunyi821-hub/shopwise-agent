# ------------------------------------------------------------------
# LLM Provider
# mock      : no API key needed, deterministic demo mode
# anthropic : Claude official API
# openai    : any OpenAI-compatible API (DeepSeek / Qwen / Zhipu ...)
# ------------------------------------------------------------------
LLM_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
# Optional proxy / gateway; leave empty for the official endpoint
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-5-5

# OpenAI-compatible (DeepSeek / Qwen / Zhipu ...)
# DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL are also read as fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
# DeepSeek example: deepseek-chat or deepseek-flash (depends on your gateway)
OPENAI_MODEL=deepseek-chat
# Optional provider-specific body, e.g. disable DeepSeek thinking:
# LLM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}

# ------------------------------------------------------------------
# Semantic retrieval (optional)
# openai   : any OpenAI-compatible /embeddings endpoint
# mock     : deterministic local vectors (tests only)
# disabled : structured + lexical search only
# ------------------------------------------------------------------
EMBEDDING_PROVIDER=disabled
# DASHSCOPE_API_KEY is also read as a fallback.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BATCH_SIZE=20

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/shopwise.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
